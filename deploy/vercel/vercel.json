{
  "rewrites": [
    { "source": "/", "destination": "/api/proxy?__p=" },
    { "source": "/:path*", "destination": "/api/proxy?__p=:path*" }
  ],
  "functions": { "api/proxy.js": { "maxDuration": 60 } },
  "headers": [
    { "source": "/(.*)", "headers": [ { "key": "X-Robots-Tag", "value": "noindex, nofollow" } ] }
  ]
}
