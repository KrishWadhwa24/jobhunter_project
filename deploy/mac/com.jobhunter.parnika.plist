<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- Starts Parnika's dashboard when you log in to the Mac and restarts it if it ever stops.
       Edit the two paths below if the project lives somewhere else. -->
  <key>Label</key><string>com.jobhunter.parnika</string>
  <key>ProgramArguments</key>
  <array>
    <string>/usr/bin/caffeinate</string>
    <string>-i</string>
    <string>/Users/krishwadhwa/Documents/jobhunter_project/.venv/bin/python</string>
    <string>-m</string>
    <string>jobhunter.service</string>
  </array>
  <key>WorkingDirectory</key><string>/Users/krishwadhwa/Documents/jobhunter_project</string>
  <key>EnvironmentVariables</key>
  <dict><key>JOBHUNTER_PROFILE</key><string>english-hons</string></dict>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>StandardOutPath</key><string>/tmp/jobhunter-parnika.log</string>
  <key>StandardErrorPath</key><string>/tmp/jobhunter-parnika.log</string>
</dict>
</plist>
