# Copy to .env and fill in. NEVER commit .env or paste these into chats.

# Telegram: create a bot with @BotFather, paste the token here.
# Then run `make chat-id` after sending /start to your bot, and paste the id below.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Storage. Leave both empty to use a local SQLite file and run without Redis.
# Point them at your existing Docker containers (host port is whatever `docker ps` shows), e.g.
#   DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@127.0.0.1:5432/jobhunter
#   REDIS_URL=redis://127.0.0.1:6379/1
# Then run `make db-create` (creates the empty `jobhunter` database) and `make doctor`.
DATABASE_URL=
REDIS_URL=

# Used in later steps (scoring, resume tailoring). Safe to leave empty for now.
GROQ_API_KEY=
GITHUB_TOKEN=
